{
  "name": "zarigani_das",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "SW_BUILD_DEV=1 node scripts/build-sw.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-water-geometry.mjs --verify && node scripts/build-sw.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "size": "size-limit",
    "size:routes": "node scripts/check-bundle-budget.mjs",
    "bench:posts": "node --import tsx scripts/bench-post-loading.ts",
    "bench:map": "node --import tsx scripts/bench-map-rendering.ts",
    "analyze": "ANALYZE=true next build",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "eval:ai": "tsx scripts/eval-ai-analysis.ts",
    "cost:ai": "tsx scripts/calc-ai-cost.ts",
    "i18n:check": "tsx scripts/check-i18n-parity.ts",
    "schema:check": "tsx scripts/check-schema-types-sync.ts",
    "auth-route:check": "node scripts/check-no-auth-route.mjs",
    "private-tables:check": "node scripts/check-private-tables-not-public.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "wasm:build": "node scripts/build-water-geometry.mjs",
    "wasm:verify": "node scripts/build-water-geometry.mjs --verify",
    "wasm:check": "node scripts/build-water-geometry.mjs --check",
    "bench:water": "node --import tsx scripts/bench-water-geometry.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=critical || true",
    "secrets:scan": "gitleaks detect --config .gitleaks.toml --redact --verbose",
    "secrets:protect": "gitleaks protect --staged --config .gitleaks.toml --redact --verbose",
    "precheck": "node scripts/precheck.mjs",
    "precheck:full": "node scripts/precheck.mjs --full",
    "oss:audit": "node scripts/audit-oss-secrets.mjs",
    "oss:audit:history": "node scripts/audit-oss-secrets.mjs --history",
    "setup:local": "tsx scripts/local-dev.ts env",
    "seed:local": "tsx scripts/local-dev.ts seed",
    "local:prepare": "node scripts/prepare-local.mjs",
    "local:start": "npm run local:prepare && supabase start --workdir .local-dev",
    "oss:export": "node scripts/export-oss-source.mjs",
    "build:cloudflare": "node scripts/cloudflare/build.mjs",
    "dry-run:cloudflare": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf-typegen": "WRANGLER_SEND_METRICS=false wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:cloudflare": "node --test scripts/cloudflare/*.checks.mjs",
    "build:cloudflare:fixture": "node scripts/cloudflare/build-fixture.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "fix-webm-duration": "^1.0.6",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "three": "^0.187.0",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.7",
    "@opennextjs/cloudflare": "1.20.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.23",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0",
    "wrangler": "4.166.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "miniflare": "5.20261113.0-beta"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.23",
    "@next/eslint-plugin-next": {
      "fast-glob": "file:./tools/next-eslint-glob"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@opennextjs/cloudflare": {
      "glob": "14.0.6"
    },
    "@node-minify/utils": {
      "fast-glob": "file:./tools/node-minify-glob"
    }
  }
}
