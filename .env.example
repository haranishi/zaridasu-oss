NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=https://zaridasu.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# REQ-212: Cloudflare Turnstile（Supabase Auth 組み込み CAPTCHA）のサイトキー（公開値）。
# 未設定だとサインアップ/認証系の CAPTCHA ウィジェットが出せず登録フローが破綻する。
# シークレットキーは Supabase Dashboard（Auth > Bot and Abuse Protection）側にのみ設定する。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# REQ-237: Web Push の VAPID「公開」鍵（base64url）。クライアントが applicationServerKey に使う。
# ★公開鍵のみ NEXT_PUBLIC_ で配る。秘密鍵は絶対に NEXT_PUBLIC_ にしない（下記 Edge 用 VAPID_PRIVATE_KEY）。
# 生成手順は docs/runbooks/web-push.md を参照。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# AI input quality gates / storage optimization
NEXT_PUBLIC_AI_INPUT_COMPRESSION_ENABLED=false
NEXT_PUBLIC_AI_BLUR_THRESHOLD=100
NEXT_PUBLIC_AI_SILENCE_THRESHOLD_DBFS=-45

# REQ-099: Sentry 本番エラー監視
# 本番環境のみ送信。dev / preview では未設定でも動作する（noopReporter のまま）
NEXT_PUBLIC_SENTRY_DSN=
# SourceMap アップロード（CI / Vercel に設定）
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Edge Function 環境変数（supabase/functions/.env に設定）
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# RESEND_API_KEY=your-resend-api-key-here
# SITE_URL=https://zaridasu.com
# ─────────────────────────────────────────────────────────────────────────────
# REQ-219: メール送信ドメイン認証（SPF/DKIM/DMARC）と送信元 From の一元化
#   通知メール（Resend）の送信元 From は全 notify-* 関数で NOTIFY_FROM_EMAIL に統一済み
#   （未設定時は既定 'ザリダス <noreply@zarigani-das.com>' にフォールバック＝既存挙動を壊さない）。
#   送信ドメイン（zarigani-das.com）を変える場合は、この値の変更と DNS の SPF/DKIM/DMARC を
#   一括で整合させること（ドリフト防止 / NFR-219-02）。From のドメインは DNS で認証済みのものに限る。
#   DNS（SPF/DKIM/DMARC）・Resend ドメイン検証・Supabase SMTP 設定は人手の運用作業。
#   手順は docs/runbooks/email-authentication.md を参照。
#   ※ NFR-219-01: 秘密値（RESEND_API_KEY / RESEND_SMTP_KEY）は DNS レコードやコミットに含めない。
# ─────────────────────────────────────────────────────────────────────────────
# 通知メール（Resend HTTP API）の送信元。表示名付き RFC5322 形式（例: 'ザリダス <noreply@zarigani-das.com>'）。
# NOTIFY_FROM_EMAIL=ザリダス <noreply@zarigani-das.com>
# 認証メール（Supabase Auth）でカスタム SMTP（Resend）を使う場合の SMTP パスワード（FR-219-06 方針 (a)）。
#   ★サーバー専用・NEXT_PUBLIC_ 厳禁・コミットしない。原則 Supabase Dashboard > Authentication > SMTP に設定する。
#   config.toml の [auth.email.smtp].pass = "env(RESEND_SMTP_KEY)" から参照される（本番のみ）。
# RESEND_SMTP_KEY=your-resend-smtp-key-here
# GEMINI_API_KEY=your-gemini-api-key-here  # https://aistudio.google.com/app/apikey で取得（無料）
# GEMINI_IMAGE_MODEL=gemini-2.0-flash
# GEMINI_AUDIO_MODEL=gemini-2.0-flash
# GEMINI_CACHE_ENABLED=true
# GEMINI_CACHE_TTL_SECONDS=86400
# GEMINI_CACHE_REFRESH_MARGIN_SECONDS=3600
# REQ-127: Gemini の出力上限トークン。デフォルト 512。MAX_TOKENS 多発時は env で上書き。
# retry 時は本値を倍にして再試行する（REQ-130 FR-130-09 で最大 2 retry、attempt2=base*4）。
# GEMINI_MAX_OUTPUT_TOKENS=512
# REQ-130: Gemini 2.5 Flash の内部 reasoning (thinking) 予算。0 = thinking 無効 (推奨)。
# gemini-2.5-flash は thinkingBudget を明示しないと内部 reasoning が maxOutputTokens を
# 食い尽くし、実テキスト 0 文字でも finishReason=MAX_TOKENS を返す。
# 128 程度なら推論精度を上げつつトークン消費は抑えられる。
# GEMINI_THINKING_BUDGET=0

# REQ-126: Gemini API キー失効検知の通知設定
# notify-gemini-key-failure Edge Function が参照する。pg_cron で定期実行する想定。
# - ADMIN_NOTIFY_EMAIL: アラート送信先 (カンマ区切りで複数可)
# - GEMINI_AUTH_FAILURE_THRESHOLD: 直近 1 時間の gemini_auth エラー件数の閾値 (既定 3)
# - GEMINI_AUTH_NOTIFY_INTERVAL_HOURS: 同種通知の最小間隔（時間, 既定 24）
# ADMIN_NOTIFY_EMAIL=ops@example.com
# GEMINI_AUTH_FAILURE_THRESHOLD=3
# GEMINI_AUTH_NOTIFY_INTERVAL_HOURS=24

# REQ-131: Edge Function webhook 共有秘密。
# Database Webhook / pg_net トリガー側で `x-webhook-secret: <値>` ヘッダーを付け、
# Edge Function 側の WEBHOOK_SECRET env と一致させる。
# 未設定の場合は grace period として通過するが、本番では必ず設定すること。
# 32 byte 以上のランダム文字列を推奨。
# WEBHOOK_SECRET=replace-with-32-byte-random-string
# REQ-240 FR-240-01: fail-closed トグル。'true'/'1' で「WEBHOOK_SECRET 未設定なら拒否」に切替。
# 本番は WEBHOOK_SECRET 設定＋動作確認後にこれを有効化して grace period を閉じる。
# WEBHOOK_SECRET_ENFORCE=true
# REQ-270 FR-270-01: pg_net SQLラッパ側は Vault の `webhook_secret` から同値を読んで
# x-webhook-secret ヘッダを付ける。DB 側にも登録すること:
#   select vault.create_secret('<WEBHOOK_SECRETと同じ値>', 'webhook_secret');
# 手順全体は docs/requirements/REQ-270-webhook-auth-chain-integrity.md FR-270-04 を参照。

# ─────────────────────────────────────────────────────────────────────────────
# REQ-215: AI/LLM（Gemini 画像・音声分析）セキュリティ
#   analyze-image / analyze-audio Edge Functions が参照する（サーバー専用・NEXT_PUBLIC_ 厳禁）。
#   - 受信後スキーマ検証・is_appropriate フェイルセーフ・concerns enum 化はコード側で常時有効。
#   - 自動承認/却下しきい値（AI_AUTO_APPROVE_BOTH 等）はコード側に安全側下限があり、
#     env でそれ未満に下げてもクランプされる（auto-approve は 0.5 未満不可）。
# ─────────────────────────────────────────────────────────────────────────────
# FR-215-08: Gemini へ送信する画像/音声の最大バイト数。超過時は Gemini を呼ばず手動審査へ回す。
#   未設定時の既定は画像 10MiB(=10485760) / 音声 15MiB(=15728640)。
#   ※ これらはコスト/メモリ暴走を防ぐサーバー側上限でもある（REQ-218 FR-218-08）。
#   クライアント側の MAX_FILE_SIZE / MAX_PHOTOS / MAX_AUDIO_SIZE はバイパス可能なので、
#   Gemini への送信前に Edge Function 側（この上限）で必ず弾く。実装主担当は REQ-215。
# AI_MAX_IMAGE_BYTES=10485760
# AI_MAX_AUDIO_BYTES=15728640

# ─────────────────────────────────────────────────────────────────────────────
# REQ-218: クラウド課金ガードレール（コスト濫用・暴走防止）
#   analyze-image / analyze-audio Edge Functions が参照する（サーバー専用・NEXT_PUBLIC_ 厳禁）。
#   予算アラート/Spend Management/Cost Anomaly はダッシュボード設定（人手）。手順は
#   docs/runbooks/cloud-cost-guardrails.md を参照。ここはコード側のフラグ/上限のみ。
# ─────────────────────────────────────────────────────────────────────────────
# FR-218-03 / AC-02: AI 分析の kill switch（コスト暴走時の即時停止フラグ）。
#   'false' で AI 分析（Gemini 呼び出し）だけを即停止する。停止中も投稿は通常どおり保存され、
#   AI 判定が付かない＝手動レビューへ回る（キーを失効させずに止められる）。
#   未設定 / 'true' は有効（後方互換・既定で動作）。DB migration 不要・Secrets 変更のみで反映。
# AI_ANALYSIS_ENABLED=true
# FR-218-01 / AC-01: MAX_TOKENS 限定リトライ（REQ-127/130）の暴走抑止。
#   AI_MAX_RETRY: 初回を除く最大再試行回数。未設定の既定は 2（= 従来どおり最大 3 回呼び出し）。
#     コスト逼迫時は 0 にすればリトライ無効（初回のみ）。retry は maxOutputTokens を倍化する
#     ため、回数を増やすほど 1 リクエストの出力トークン課金が増える点に注意。
#   AI_REQUEST_TOTAL_TIMEOUT_MS: retry を含む 1 リクエスト全体の最大経過時間（ms）。
#     超過 / 超過見込みなら次の試行に入らず打ち切り（ai_failure_count 加算 + error 記録 →
#     手動審査。新たな自動再投入はしない）。0 で無効化。未設定の既定は 120000。
#   AI_RETRY_BASE_DELAY_MS / AI_RETRY_MAX_DELAY_MS: 指数バックオフ + ジッタの基準/上限（ms）。
#     未設定の既定は 500 / 8000。即時連続リトライをやめ瞬間的な集中課金を避ける。
# AI_MAX_RETRY=2
# AI_REQUEST_TOTAL_TIMEOUT_MS=120000
# AI_RETRY_BASE_DELAY_MS=500
# AI_RETRY_MAX_DELAY_MS=8000
# FR-218-06: AI 利用量/コストの異常検知しきい値（週次手動確認 or pg_cron 通知で使用）。
#   REQ-215 AC-07（auto-approve 率 / AI 呼び出し頻度の異常通知）と二重実装しない。コスト観点の
#   閾値として、直近 1 時間の AI 呼び出し回数 / 推定コストの上限を定義する。
#   ※ AI_COST_ALERT_CALLS_PER_HOUR は REQ-215 の notify-ai-anomaly が「窓内 AI 呼び出し総数」の
#     異常閾値として共有する（下の REQ-215 セクション参照。コスト観点の閾値は一本化する）。
# AI_COST_ALERT_CALLS_PER_HOUR=500
# AI_COST_ALERT_USD_PER_DAY=5

# ─────────────────────────────────────────────────────────────────────────────
# REQ-215 FR-215-07(b): AI 自動判定の濫用/異常検知の通知設定
#   notify-ai-anomaly Edge Function が参照（pg_cron で 15 分ごとに起動する想定。
#   集計 RPC detect_ai_anomalies が既存 ai_call_logs / posts を事後集計する）。
#   検知次元と既定（安全側。env で調整可。すべてサーバー専用・NEXT_PUBLIC_ 厳禁）:
#   - AI_ANOMALY_WINDOW_MINUTES: 集計窓（分・既定 60）
#   - AI_ANOMALY_MIN_SAMPLES: auto-approve 率を評価する最小標本数（少数で誤検知しない・既定 20）
#   - AI_ANOMALY_AUTO_APPROVE_RATE: auto-approve 率の異常閾値 0..1（既定 0.90。コード側の
#     AUTO_APPROVE_FLOOR=0.5 とは別レイヤ＝「自動承認が多すぎる」状態の検知閾値）
#   - AI_ANOMALY_PER_ACTOR_CALLS: 単一ユーザー/IP(ハッシュ) の呼び出し回数 異常閾値（既定 50）
#   - AI_ANOMALY_NOTIFY_INTERVAL_HOURS: 同種通知の最小間隔（時間・既定 6。通知洪水防止）
#   ※ 窓内 AI 呼び出し総数の閾値は上の AI_COST_ALERT_CALLS_PER_HOUR を共有する（二重定義しない）。
#   ※ 送信は既存の RESEND_API_KEY / ADMIN_NOTIFY_EMAIL / NOTIFY_FROM_EMAIL / SITE_URL を共用。
#   閾値の決め方・誤検知時の調整は docs/runbooks/ai-anomaly-detection.md を参照。
# AI_ANOMALY_WINDOW_MINUTES=60
# AI_ANOMALY_MIN_SAMPLES=20
# AI_ANOMALY_AUTO_APPROVE_RATE=0.90
# AI_ANOMALY_PER_ACTOR_CALLS=50
# AI_ANOMALY_NOTIFY_INTERVAL_HOURS=6

# REQ-218 FR-218-07 / AC-07: 開発 / 本番（Preview 含む）の分離について。
#   - Gemini（Google Cloud）は**プロジェクト単位**で課金・レート制限が評価される。開発/テストの
#     暴走を本番課金へ波及させないため、**本番 GEMINI_API_KEY を開発 / Preview で使い回さない**こと。
#     可能なら開発用に別 Google Cloud プロジェクト + 別 API キーを用意する。
#   - Supabase も開発用と本番用でプロジェクトを分けるのが望ましい（SUPABASE_URL /
#     SERVICE_ROLE_KEY / PROJECT_REF を環境ごとに別管理）。CI の SUPABASE_PROJECT_REF は
#     本番 ref のみを参照し、テストが本番に書き込まない構成にする。
#   - Vercel は Production / Preview / Development で環境変数スコープを分け、上記の秘密値を
#     スコープ越しに共有しない。
# ─────────────────────────────────────────────────────────────────────────────
# REQ-231: 逆ジオコーディング（字レベル地名・水系・水辺フラグ・標高）の付与
#   Edge Function enrich-place が参照する。posts INSERT → pg_net で非同期起動。
#   Nominatim は無料だが利用規約の順守が必須（1req/秒・識別可能 User-Agent・結果キャッシュ・
#   bulk 禁止）。これらはサーバー側（_shared/geocodeThrottle + geocodeProvider + geo_cache 表）
#   で担保する。商用/高頻度に移行する場合は OpenCage / Geoapify（プロジェクト単位の従量課金）
#   へ GEOCODE_PROVIDER で切替/フォールバックする。※ apiKey の実値はコミットしない（変数名のみ）。
# ─────────────────────────────────────────────────────────────────────────────
# 逆ジオプロバイダ: nominatim（既定）/ opencage / geoapify
# GEOCODE_PROVIDER=nominatim
# Nominatim 規約必須の識別可能 User-Agent に差す連絡先（メール等）。本番では設定推奨。
# GEOCODE_CONTACT_EMAIL=ops@example.com
# 商用/高頻度フォールバック用 apiKey（任意・GEOCODE_PROVIDER で選択時に必須）
# OPENCAGE_API_KEY=your-opencage-api-key-here
# GEOAPIFY_API_KEY=your-geoapify-api-key-here
# 逆ジオ呼び出しの最小間隔（ms）。Nominatim の 1req/秒上限 + 安全マージン（既定 1100）
# GEOCODE_MIN_INTERVAL_MS=1100
# 1 リクエストのタイムアウト（ms・既定 5000）とリトライ上限（既定 2・指数バックオフ+ジッタ）
# GEOCODE_TIMEOUT_MS=5000
# GEOCODE_MAX_RETRIES=2
# kill switch（AC-07）: 'false' で逆ジオ付与を即停止。停止中も投稿は成立（列は NULL のまま）
# GEO_ENRICH_ENABLED=true
# 水辺フラグ（OnWater）を取得するか（既定 false）。高頻度時は ONWATER_API_KEY 要
# GEO_WATER_ENABLED=false
# ONWATER_API_KEY=your-onwater-api-key-here
# 標高（Open Topo Data）を取得するか（既定 false）。CORS 不可のためサーバー側のみ（AC-05）
# GEO_ELEVATION_ENABLED=false
# OPENTOPODATA_DATASET=aster30m
# geo_cache の TTL（日）。地名はほぼ不変なので長め（既定 365）
# GEO_CACHE_TTL_DAYS=365

# ─────────────────────────────────────────────────────────────────────────────
# REQ-234: ライフサイクルメール（研究採用通知・休眠復帰・週次ダイジェスト / Resend）
#   Edge Functions notify-research-adopted / notify-dormant-reengage / notify-weekly-digest が参照。
#   研究採用は adopt_post_research() → pg_net で、休眠復帰/週次は pg_cron で起動される。
#   到達性（SPF/DKIM/DMARC）は REQ-219 が主管（本 REQ のスコープ外）。
#   ※ 秘密値（RESEND_API_KEY / WEBHOOK_SECRET / service-role key）はコミットしない＝変数名のみ。
#     これらは Supabase Dashboard → Edge Functions → Secrets に設定する（NEXT_PUBLIC_ は厳禁）。
# ─────────────────────────────────────────────────────────────────────────────
# 送信は既存の RESEND_API_KEY / SITE_URL / NOTIFY_FROM_EMAIL / WEBHOOK_SECRET を共用する
# （上記「Edge Function 環境変数」「REQ-131」の項を参照）。本 REQ で追加する任意の調整値:
# 休眠判定の無活動日数（既定 14）/ 同一ユーザへの再送下限日数（既定 30）/ 1 回の抽出上限（既定 200）
# DORMANT_DAYS=14
# DORMANT_RESEND_MIN_DAYS=30
# DORMANT_BATCH_LIMIT=200
# 週次ダイジェストの 1 回の抽出上限（既定 500）
# WEEKLY_BATCH_LIMIT=500

# ─────────────────────────────────────────────────────────────────────────────
# REQ-237: Web Push（即時リエンゲージ / send-push Edge Function が参照）
#   メール（REQ-234）と相補的な「即時」チャネル。投稿承認/却下・コメント・周辺新着を push で届ける。
#   ※ 秘密値（VAPID_PRIVATE_KEY）は ★サーバー専用★。NEXT_PUBLIC_ 厳禁・コミットしない・ログに出さない
#     （NFR-237-01 / REQ-211）。Supabase Dashboard → Edge Functions → Secrets に設定する。
#   鍵ペアの生成手順は docs/runbooks/web-push.md を参照（公開鍵は上の NEXT_PUBLIC_VAPID_PUBLIC_KEY と同じ値）。
# ─────────────────────────────────────────────────────────────────────────────
# VAPID 公開鍵（base64url raw P-256）。クライアントの NEXT_PUBLIC_VAPID_PUBLIC_KEY と同一値。
# VAPID_PUBLIC_KEY=
# VAPID 秘密鍵（base64url raw P-256 スカラ d）。★サーバー専用・絶対に公開しない★
# VAPID_PRIVATE_KEY=
# VAPID の連絡先（mailto: または https:）。push service が問題時に参照する。
# VAPID_SUBJECT=mailto:ops@example.com
# webhook 共有秘密は既存 WEBHOOK_SECRET を共用（送信元検証 / REQ-131）。

# ─────────────────────────────────────────────────────────────────────────────
# REQ-236: SNS 自動投稿（social-announce Edge Function が参照。サーバー専用）
#   Late API 経由で承認済み投稿を SNS へ自動アナウンスする。未設定なら機能は no-op。
# ─────────────────────────────────────────────────────────────────────────────
# LATE_API_KEY=your-late-api-key-here
# LATE_API_URL=https://api.late.dev
# 添付画像の取得元 Storage バケット名（既定 post-photos）
# SOCIAL_ANNOUNCE_BUCKET=post-photos
